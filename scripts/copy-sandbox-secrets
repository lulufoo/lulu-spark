#!/usr/bin/env bash
# Copy prod debug secrets into the shared sandbox secrets file (explicit, never automatic).
# Usage: ./scripts/copy-sandbox-secrets
set -euo pipefail

HOME_DIR="${HOME:-}"
if [[ -z "$HOME_DIR" ]]; then
  echo "copy-sandbox-secrets: HOME is unset" >&2
  exit 1
fi

SRC="$HOME_DIR/.config/lulu-workbench/dev-secrets.toml"
DEST_DIR="$HOME_DIR/.config/lulu-workbench-sandbox"
DEST="$DEST_DIR/dev-secrets.toml"

if [[ ! -f "$SRC" ]]; then
  echo "copy-sandbox-secrets: source missing: $SRC" >&2
  exit 1
fi

mkdir -p "$DEST_DIR"
cp "$SRC" "$DEST"
echo "copy-sandbox-secrets: copied -> $DEST"
