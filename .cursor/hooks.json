{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "matcher": "Read|Write|Edit|Shell",
        "command": "python3 ~/.cursor/skills/lulu-rule-guard/scripts/entry.py --platform cursor",
        "timeout": 5,
        "failClosed": false
      },
      {
        "matcher": "Write|Edit|Read|Shell",
        "command": "python3 /Users/lulu/.cursor/skills/lulu-dev-workflow/scripts/hook/hook_guard.py",
        "timeout": 5,
        "failClosed": true
      }
    ],
    "stop": [
      {
        "command": "python3 ~/.cursor/skills/lulu-rule-guard/scripts/play_chime.py --platform cursor",
        "timeout": 5,
        "failClosed": false
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "python3 /Users/lulu/.cursor/skills/lulu-dev-workflow/scripts/hook/hook_prompt.py --platform cursor",
        "timeout": 5
      }
    ]
  }
}
