{
  "version": 2,
  "chime": {
    "enabled": true,
    "sound": "/System/Library/Sounds/Funk.aiff",
    "volume": 1,
    "gain": 25
  },
  "fileGuard": {
    "enabled": true,
    "rulesDocsDir": "docs",
    "rules": [
      {
        "glob": "**/*.{js,ts,jsx,tsx,py,go,rs,rb,swift,html,css,json,java,kt}",
        "required": [
          "docs/coding/coding-global-discipline.md"
        ]
      },
      {
        "glob": "**/*.{ts,js}",
        "required": [
          "docs/coding/coding-workbench-discipline.md"
        ]
      },
      {
        "glob": "**/*.md",
        "required": [
          "docs/md/md-operations.md"
        ]
      }
    ]
  }
}
