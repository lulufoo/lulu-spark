{
  "version": 2,
  "fileGuard": {
    "rules": [
      {
        "glob": "**/*.{js,ts,jsx,tsx,py,go,rs,rb,swift,html,css,json,java,kt}",
        "required": [
          ".cursor/skills/lulu-discipline-skills/coding/coding-global-discipline.md"
        ]
      },
      {
        "glob": "**/*.{html,css}",
        "required": [
          ".cursor/skills/lulu-discipline-skills/coding/html-css-coding-constraints.md"
        ]
      },
      {
        "glob": "**/*.java",
        "required": [
          ".cursor/skills/lulu-discipline-skills/coding/java-coding-constraints.md"
        ]
      },
      {
        "glob": "**/*.kt",
        "required": [
          ".cursor/skills/lulu-discipline-skills/coding/kt-coding-constraints.md"
        ]
      },
      {
        "glob": "**/*.py",
        "required": [
          ".cursor/skills/lulu-discipline-skills/coding/py-coding-constraints.md"
        ]
      },
      {
        "glob": "**/*.rs",
        "required": [
          ".cursor/skills/lulu-discipline-skills/coding/rs-coding-constraints.md"
        ]
      },
      {
        "glob": "**/*.{ts,tsx,js}",
        "required": [
          ".cursor/skills/lulu-discipline-skills/coding/ts-coding-constraints.md"
        ]
      },
      {
        "glob": "**/*.md",
        "required": [
          ".cursor/skills/lulu-discipline-skills/md/md-global-discipline.md"
        ]
      }
    ],
    "enabled": true
  }
}
