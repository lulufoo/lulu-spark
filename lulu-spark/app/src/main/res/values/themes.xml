<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.LuLuSpark" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/studio_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.LuluSpark.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/studio_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash</item>
        <item name="postSplashScreenTheme">@style/Theme.LuLuSpark</item>
    </style>
</resources>
