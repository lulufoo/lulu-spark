{
  "version": 1,
  "hooks": {
    "PreToolUse": [
      {
        "type": "command",
        "command": "python3 ~/.copilot/skills/lulu-rule-guard/scripts/entry.py --platform copilot",
        "timeout": 5
      },
      {
        "type": "command",
        "command": "python3 ~/.copilot/skills/lulu-dev-workflow/scripts/hook_guard.py --platform copilot",
        "timeout": 5
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "python3 ~/.copilot/skills/lulu-rule-guard/scripts/play_chime.py --platform copilot",
        "timeout": 5
      }
    ]
  }
}
