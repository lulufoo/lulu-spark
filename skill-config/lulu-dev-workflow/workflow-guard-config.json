{
  "version": 2,
  "logs": {
    "enabled": true
  },
  "internalPathGuard": {
    "enable": false,
    "defaults": {
      "readDirs": [
        "."
      ],
      "writeDirs": [
        ".cache/{platform}/lulu-dev-workflow"
      ]
    },
    "stages": {
      "lulu-code": {
        "readDirs": [
          "."
        ],
        "writeDirs": [
          ".cache/worktrees",
          ".cache/{platform}/lulu-dev-workflow"
        ]
      }
    }
  },
  "externalPathGuard": {
    "enabled": true,
    "writeAllowExternalPaths": [
      "~/.cursor",
      "~/.copilot/",
      "~/.claude/"
    ],
    "readAllowExternalPaths": [
      "~/.cursor/",
      "~/.copilot/",
      "~/.claude/"
    ],
    "sessionAllow": true
  }
}
