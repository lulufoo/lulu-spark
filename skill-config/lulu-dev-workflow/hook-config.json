{
  "version": 1,
  "rwGuard": {
    "enable": true,
    "bypassWriteWhenDelivered": true,
    "defaults": {
      "readDirs": [
        ".",
        "{platform-skills}"
      ],
      "writeDirs": [
        ".cache/{platform}/lulu-dev-workflow"
      ]
    },
    "stages": {
      "tech-code": {
        "readDirs": [
          ".",
          "{platform-skills}"
        ],
        "writeDirs": [
          ".cache/worktrees",
          ".cache/{platform}/lulu-dev-workflow"        
        ]
      }
    }
  }
}