{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lulu-spark-cloud-sync",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-23",
  // Production hostname used by the Spark client (`WORKER_URL`). The workers.dev
  // address stays up so an install that has not been rebuilt can still reach it.
  "workers_dev": true,
  "routes": [
    { "pattern": "cloud-sync.luluspark.app", "custom_domain": true }
  ],
  // Public values, not secrets.
  // - SUPABASE_URL: the token check reads the signing keys from
  //   `${SUPABASE_URL}/auth/v1/.well-known/jwks.json`.
  // - GCS_PROJECT_ID / GCS_PROJECT_NUMBER: the Google Cloud project that holds every user's bucket.
  //   A bucket counts as ours only if it reports this project number.
  // - MAX_OBJECT_BYTES / MAX_USER_TOTAL_BYTES: the size limits, checked when an upload link is asked
  //   for. The total counts old versions the 3-day cleanup has not removed yet. There is no default in
  //   the code: a missing or invalid value stops the storage routes.
  //   Set by the project owner to 10 MiB and 1 GiB. Change the numbers here to adjust them.
  // - UPLOAD_LINK_LIFETIME_SECONDS: how long an upload link works (60 to 3600). The whole upload
  //   must finish inside it, or Google refuses the upload at the end. Set by the owner to 10 minutes.
  "vars": {
    "SUPABASE_URL": "https://ysvsmsvfyzahevkximog.supabase.co",
    "GCS_PROJECT_ID": "spark-cloud-sync",
    "GCS_PROJECT_NUMBER": "55973988960",
    "MAX_OBJECT_BYTES": 10485760,
    "MAX_USER_TOTAL_BYTES": 1073741824,
    "UPLOAD_LINK_LIFETIME_SECONDS": 600
  },
  // Set with `wrangler secret put <NAME>`; deploy fails while one is missing.
  // - GCS_SERVICE_ACCOUNT_KEY: the long-lived service account key file, as one JSON line.
  // - BUCKET_NAME_KEY: random text that turns a user id into a bucket name. Never change or lose it.
  "secrets": {
    "required": ["GCS_SERVICE_ACCOUNT_KEY", "BUCKET_NAME_KEY"]
  },
  "observability": {
    "enabled": true,
    "traces": { "enabled": true }
  }
}
