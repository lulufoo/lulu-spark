{
  "manifest_version": 3,
  "name": "Workbench",
  "version": "1.2.0",
  "description": "Save the current tab to Read Later. On X Home and reply dialog, translate Chinese to English in place.",
  "permissions": ["activeTab"],
  "host_permissions": ["https://localhost:7654/*"],
  "background": {
    "service_worker": "read-later/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Save to Workbench Read Later",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["x-zh-en/compose-dom.js", "x-zh-en/compose-write.js", "x-zh-en/content.js"],
      "css": ["x-zh-en/content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["x-zh-en/compose-translator.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ]
}
