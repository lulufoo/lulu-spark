# Meilisearch 配置（外置服务；见 docs/meilisearch-dev.md）
# Verified: meilisearch 1.43.0 (macOS brew)
# App / server.py 不启动 Meili 进程

MEILI_URL=http://localhost:7700
MEILI_MASTER_KEY=lulu-workbench-local
KNOWLEDGE_BASE_DIR=/Users/lulu/Code

# 语料库根目录：lulu-workbench-knowledge 本地路径
KNOWLEDGE_CORPUS_DIR=/Users/lulu/Code/lulu-workbench-knowledge

# 语料库 GitHub blob 链接前缀（UI 与沉淀来源）
KNOWLEDGE_CORPUS_GITHUB=https://github.com/lulufoo/lulu-workbench-knowledge/blob/main
