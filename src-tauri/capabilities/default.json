{
  "$schema": "../node_modules/@tauri-apps/cli/schema/acl/schemas/capability.schema.json",
  "identifier": "default",
  "description": "Default capabilities for Lulu Spark",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-set-theme",
    "read-api",
    "write-api",
    "sync-api",
    "search-api",
    "opener:default",
    "dialog:default"
  ]
}
