{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lulu Spark",
  "version": "0.1.0",
  "identifier": "com.lulu.workbench",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Lulu Spark",
        "width": 1280,
        "height": 800
      }
    ],
    "security": {
      "csp": "default-src 'self' tauri: asset:; connect-src 'self' tauri: ipc: http://ipc.localhost https://ipc.localhost https: http: ws: wss:; img-src 'self' blob: data: tauri: asset:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'unsafe-eval'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "msi",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "infoPlist": "Info.plist"
    }
  },
  "plugins": {
    "workbench-scheme": {
      "CFBundleURLTypes": [
        {
          "CFBundleURLName": "com.lulu.workbench",
          "CFBundleURLSchemes": [
            "workbench"
          ]
        }
      ]
    }
  }
}
