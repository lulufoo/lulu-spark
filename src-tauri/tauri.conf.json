{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LuLu Workbench",
  "version": "0.1.0",
  "identifier": "com.lulu.workbench",
  "build": {
    "frontendDist": "../.cache/tauri-frontend-dist",
    "devUrl": "http://localhost:8765",
    "beforeDevCommand": "python3 server.py",
    "beforeBuildCommand": "bash ../scripts/build-tauri-frontend-dist.sh"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "LuLu Workbench",
        "width": 1280,
        "height": 800
      }
    ],
    "security": {
      "csp": "default-src 'self' tauri: asset: http://localhost:8765; connect-src http://localhost:8765 ws://localhost:8765; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net"
    }
  },
  "plugins": {
    "shell": {
      "open": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
