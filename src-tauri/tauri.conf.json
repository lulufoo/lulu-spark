{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LuLu Workbench",
  "version": "0.1.0",
  "identifier": "com.lulu.workbench",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "LuLu Workbench",
        "width": 1280,
        "height": 800
      }
    ],
    "security": {
      "csp": "default-src 'self' tauri: asset:; connect-src 'self' tauri: https: http:; img-src 'self' blob: data: tauri: asset:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "msi",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
